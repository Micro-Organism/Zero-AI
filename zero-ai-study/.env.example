# 复制为 .env 后填写（不要把真实 Token 提交到 Git）
# cp .env.example .env

# Hugging Face Access Token（至少 Read；上传模型需要 Write）
# 获取：https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：国内或镜像加速（按你实际可用的镜像填写）
# HF_ENDPOINT=https://huggingface.co

# 可选：默认实验名
EXPERIMENT_NAME=zero-ai-study-sft-demo
